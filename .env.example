# =============================================================================
# Kalaai Code - Docker Compose environment
#   cp .env.example .env      (never commit .env)
# Used by docker-compose.yml and docker-compose.dev.yml (variable substitution
# + env_file for the api service). For running the backend directly on your
# machine use backend/.env.example instead.
# =============================================================================

# --- App ---------------------------------------------------------------------
# development | production  (production refuses to start with the default SECRET_KEY)
ENVIRONMENT=production
# Where the SPA is served (OAuth redirects land here). Compose web = 3000, Vite dev = 5173
FRONTEND_URL=http://localhost:3000
# CORS origins - JSON list (single-quoted so the inner double quotes survive)
ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:5173"]'
# Set false to disable slowapi rate limits (tests / local load testing)
RATE_LIMIT_ENABLED=true

# --- PostgreSQL (db service) -------------------------------------------------
POSTGRES_USER=kalaai
# REQUIRED. Use a URL-safe value (letters, digits, - _) - it is embedded in DATABASE_URL
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=kalaai_code
# Informational only: compose builds DATABASE_URL for the api container from the
# POSTGRES_* values above (host `db`), overriding anything set here.
DATABASE_URL=postgresql://kalaai:change-me-db-password@db:5432/kalaai_code

# --- Auth --------------------------------------------------------------------
# REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth (optional - email/password works without it) ---------------
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID
# (type "Web application"). Add the redirect URI below as an Authorized redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Anthropic Claude (optional to boot; required for AI reviews/roasts) ------
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_MAX_TOKENS=4096

# --- GitHub (optional - raises the GitHub API rate limit for repo fetching) ---
# Fine-grained personal access token with public-repo read access
GITHUB_TOKEN=

# --- Uploads -----------------------------------------------------------------
# Inside the container this is forced to /app/uploads (named volume `uploads`)
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=5
MAX_UPLOAD_FILES=50
# Max AI review/roast pipelines running at once (protects the worker thread pool)
MAX_CONCURRENT_PIPELINES=3

# --- Reverse proxy ------------------------------------------------------------
# uvicorn only trusts X-Forwarded-* headers from these addresses (rate limiting keys
# on the client IP). Set to the proxy's network/IP (e.g. the docker network CIDR).
# Never use * unless the API is reachable ONLY through the proxy.
# FORWARDED_ALLOW_IPS=127.0.0.1

# --- Frontend (baked into the JS bundle at image BUILD time) ------------------
# Must be the API URL as seen from the user's browser. Rebuild `web` after changing.
VITE_API_URL=http://localhost:8000

# --- Optional host port overrides ---------------------------------------------
# WEB_PORT=3000
# API_PORT=8000
# POSTGRES_PORT=5432
