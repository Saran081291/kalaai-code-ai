# =============================================================================
# Kalaai Code - PRODUCTION environment (VPS behind an existing Traefik proxy)
#   bash deploy/make-env.sh        creates .env from this file and generates the secrets
# Then edit .env: fill the TRAEFIK_* values, add an AI key, optionally Google.
# Never commit .env.
# =============================================================================

# --- Public address ------------------------------------------------------------
# One host serves the app and the API. sslip.io gives a free name that resolves to
# the IP: 77.37.45.4 -> 77-37-45-4.sslip.io (works without buying a domain).
KALAAI_HOST=77-37-45-4.sslip.io
FRONTEND_URL=https://77-37-45-4.sslip.io
ALLOWED_ORIGINS='["https://77-37-45-4.sslip.io"]'
# Baked into the frontend at image BUILD time. Same origin as the app (Traefik routes /api).
VITE_API_URL=https://77-37-45-4.sslip.io

# --- Existing Traefik (values from: bash deploy/discover-traefik.sh) -------------
# Name of Traefik's ACME certificate resolver, e.g. mytlschallenge
TRAEFIK_CERTRESOLVER=
# HTTPS entrypoint name (usually websecure)
TRAEFIK_ENTRYPOINT=websecure

# --- App -------------------------------------------------------------------------
ENVIRONMENT=production
RATE_LIMIT_ENABLED=true
FORWARDED_ALLOW_IPS=*

# --- PostgreSQL ------------------------------------------------------------------
POSTGRES_USER=kalaai
# make-env.sh generates this (URL-safe)
POSTGRES_PASSWORD=
POSTGRES_DB=kalaai_code

# --- Auth ------------------------------------------------------------------------
# make-env.sh generates this
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth (optional - email/password works without it) -------------------
# Add https://77-37-45-4.sslip.io as an Authorized JavaScript origin and the redirect
# URI below in Google Cloud Console. Keep the consent screen's Test users up to date.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://77-37-45-4.sslip.io/api/v1/auth/google/callback

# --- AI provider: pick ONE ---------------------------------------------------------
# AI_PROVIDER: anthropic | openai
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_MAX_TOKENS=4096

# --- GitHub (optional - raises the API rate limit for repo fetching) -------------
GITHUB_TOKEN=

# --- Uploads ---------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=5
MAX_UPLOAD_FILES=50
MAX_CONCURRENT_PIPELINES=3
