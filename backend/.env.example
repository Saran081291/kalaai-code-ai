# =============================================================================
# Kalaai Code backend - local (non-Docker) development
#   cp .env.example .env      (never commit .env)
# Read by app/config.py (pydantic-settings) when uvicorn/alembic/pytest run
# from the backend/ directory. Docker Compose uses the ROOT .env instead.
# =============================================================================

# --- App ---------------------------------------------------------------------
# development | production  (production refuses to start with the default SECRET_KEY)
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
# CORS origins - JSON list (single-quoted so the inner double quotes survive)
ALLOWED_ORIGINS='["http://localhost:5173","http://localhost:3000"]'
RATE_LIMIT_ENABLED=true

# --- Database (PostgreSQL on your machine, or `docker compose up -d db`) ------
DATABASE_URL=postgresql://kalaai:change-me-db-password@localhost:5432/kalaai_code

# --- Auth --------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth (optional) -------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID
# (type "Web application"); add GOOGLE_REDIRECT_URI as an Authorized redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Anthropic Claude (required for AI reviews/roasts; never used by tests) ---
# Get a key at https://console.anthropic.com/settings/keys
# AI_PROVIDER: anthropic (default) | openai
AI_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_MAX_TOKENS=4096

# --- GitHub (optional - raises the GitHub API rate limit) ---------------------
GITHUB_TOKEN=

# --- Uploads -----------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
MAX_UPLOAD_FILES=50
# Max AI review/roast pipelines running at once (protects the worker thread pool)
MAX_CONCURRENT_PIPELINES=3

# --- Reverse proxy ------------------------------------------------------------
# uvicorn only trusts X-Forwarded-* headers from these addresses (rate limiting keys
# on the client IP). Set to the proxy's network/IP (e.g. the docker network CIDR).
# Never use * unless the API is reachable ONLY through the proxy.
# FORWARDED_ALLOW_IPS=127.0.0.1

# --- Frontend (used by frontend/.env, listed here for reference) --------------
VITE_API_URL=http://localhost:8000
